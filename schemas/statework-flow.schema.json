{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitivestatework.dev/schemas/statework-flow.schema.json",
  "type": "object",
  "required": [
    "flow",
    "required_specialists",
    "optional_specialists"
  ],
  "properties": {
    "flow": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "$ref": "#/$defs/predicate"
    },
    "fallback": {
      "type": "boolean"
    },
    "states": {
      "type": "object",
      "properties": {
        "through": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "claim_classes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "minimum_state",
              "evidence_kinds"
            ],
            "properties": {
              "minimum_state": {
                "type": "string",
                "minLength": 1
              },
              "evidence_kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "enhancements": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "required_specialists": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_specialists": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "when"
      ]
    },
    {
      "properties": {
        "fallback": {
          "const": true
        }
      },
      "required": [
        "fallback"
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "field",
            "in"
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.]{0,63}$"
            },
            "in": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
