{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitivestatework.dev/schemas/terraformer_integration_packet.schema.json",
  "title": "TerraFormer StateWork handoff",
  "allOf": [
    {
      "$ref": "handoff-packet.schema.json"
    },
    {
      "type": "object",
      "required": [
        "packet_type",
        "producer",
        "schema_version",
        "payload"
      ],
      "properties": {
        "packet_type": {
          "const": "terraformer_integration_packet"
        },
        "producer": {
          "const": "terraformer"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "payload": {
          "type": "object",
          "required": [
            "architecture_boundary",
            "outcome",
            "composition_fingerprint",
            "claim_evidence_refs"
          ],
          "properties": {
            "architecture_boundary": {
              "$ref": "#/$defs/architecture_boundary"
            },
            "outcome": {
              "enum": [
                "integrated",
                "not_needed",
                "incompatible",
                "partial",
                "blocked",
                "invalidated"
              ]
            },
            "composition_fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "claim_evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "architecture_boundary": {
      "title": "Architecture Boundary Packet — technology-neutral facts",
      "description": "Shared interchange payload. Independently produced by any competent source; does not require GodKiller or TerraFormer.",
      "type": "object",
      "required": [
        "schema_version",
        "subject",
        "baseline",
        "responsibilities",
        "components",
        "interfaces",
        "ownership_map",
        "dependency_edges",
        "lifecycle_contracts",
        "invariants",
        "migration",
        "verification",
        "unresolved"
      ],
      "properties": {
        "schema_version": {
          "const": "architecture-boundary/v1"
        },
        "subject": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "kind",
            "fingerprint",
            "observed_at"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "baseline": {
          "type": "object",
          "required": [
            "contract_refs",
            "evidence_refs",
            "observables"
          ],
          "properties": {
            "contract_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "observables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "claim",
                  "oracle_ref"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "oracle_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "current_owner",
              "target_owner",
              "evidence_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "current_owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "responsibility_ids",
              "reads",
              "writes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "responsibility_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "reads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "writes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "contract_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "lifecycle_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "provider",
              "consumers",
              "contract_ref",
              "version",
              "failure_semantics"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "failure_semantics": {
                "type": "string",
                "minLength": 1
              },
              "compatibility_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "ownership_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "resource_id",
              "mutable",
              "authority"
            ],
            "properties": {
              "resource_id": {
                "type": "string",
                "minLength": 1
              },
              "mutable": {
                "type": "boolean"
              },
              "authority": {
                "type": "object",
                "required": [
                  "mode",
                  "owners",
                  "protocol",
                  "conflict_resolution"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "exclusive",
                      "coordinated_shared",
                      "external"
                    ]
                  },
                  "owners": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "protocol": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "conflict_resolution": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "dependency_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "contract_ref",
              "reason"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "lifecycle_contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "component_id",
              "phases",
              "failure_policy",
              "recovery_policy"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "component_id": {
                "type": "string",
                "minLength": 1
              },
              "phases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "failure_policy": {
                "type": "string",
                "minLength": 1
              },
              "recovery_policy": {
                "type": "string",
                "minLength": 1
              },
              "cancellation_policy": {
                "type": "string",
                "minLength": 1
              },
              "teardown_policy": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "evidence_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "migration": {
          "type": "object",
          "required": [
            "steps",
            "compatibility_requirements",
            "rollback_requirements"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description",
                  "preconditions",
                  "rollback",
                  "verification_refs"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "preconditions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "rollback": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "compatibility_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "rollback_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "required": [
            "required_checks",
            "evidence_refs"
          ],
          "properties": {
            "required_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "claim",
                  "oracle",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "oracle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "pass",
                      "fail",
                      "blocked"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "severity",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "low",
                  "moderate",
                  "high",
                  "critical"
                ]
              },
              "blocks": {
                "type": "boolean"
              },
              "next_observation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
