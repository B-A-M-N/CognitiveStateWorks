{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitivestatework.dev/schemas/repository-evidence-packet.schema.json",
  "title": "Repository evidence packet",
  "description": "Evidence produced by Getter while mutating repository state (merge/rebase/reset/revert results, integrity checks).",
  "allOf": [
    { "$ref": "handoff-packet.schema.json" },
    {
      "properties": {
        "packet_type": { "const": "repository_evidence_packet" },
        "producer": { "const": "getter" },
        "schema_version": { "const": "1.1.0" },
        "payload": {
          "type": "object",
          "required": ["operation", "result", "observed_head", "evidence"],
          "properties": {
            "operation": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "enum": ["success", "failure", "partial", "aborted"] },
            "observed_head": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "notes": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
