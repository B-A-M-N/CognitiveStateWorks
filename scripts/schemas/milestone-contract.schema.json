{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitivestatework.dev/schemas/milestone-contract.schema.json",
  "type": "object",
  "required": ["version", "steps"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128 },
      "additionalProperties": {
        "type": "object",
        "properties": { "terminal_required": { "type": "boolean" } },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "depends_on": { "$ref": "#/$defs/step_ids" },
          "required_evidence": { "$ref": "#/$defs/step_ids" },
          "requires_facts": { "$ref": "#/$defs/fact_ids" },
          "establishes_facts": { "$ref": "#/$defs/fact_ids" },
          "invalidates_facts": { "$ref": "#/$defs/fact_ids" },
          "work_class": { "type": "string", "minLength": 1, "maxLength": 64 },
          "domain_effect": { "type": "string", "minLength": 1, "maxLength": 128 },
          "progress_class": { "enum": ["FORWARD_PROGRESS", "LATERAL", "RECOVERY", "INVALIDATION", "REGRESSION", "TERMINAL"] }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "step_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "fact_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "additionalProperties": false
}
